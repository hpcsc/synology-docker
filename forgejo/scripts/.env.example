# Values used by the Forgejo mirror scripts
# (mirror-repos.py, sync-recent-repos.py, disable-mirrors.py).

# Full base URL of the Forgejo instance, including scheme and port.
# Must match FORGEJO_ROOT_URL in ../.env.
FORGEJO_ROOT_URL=https://penguin-nas:4000

# Forgejo API token for the mirror scripts.
# The token must have permission to create repositories.
FORGEJO_TOKEN=forgejo_api_token

# Forgejo username or organization that will own the mirrored repositories.
FORGEJO_OWNER=your_forgejo_username

# Verify SSL certificate when connecting to Forgejo from the mirror scripts.
# Set to false if using a self-signed certificate (common with Synology reverse proxy).
FORGEJO_VERIFY_SSL=true

# GitHub personal access token for mirroring private repositories.
# Classic token needs 'repo' scope. Fine-grained token needs read access to repos.
GITHUB_TOKEN=ghp_xxx

# GitHub username used by the mirror scripts to find your commits and repos.
GITHUB_OWNER=your-github-username

# How often Forgejo should pull changes from GitHub (mirror-repos.py).
MIRROR_INTERVAL=8h

# Number of days to look back on the first run of sync-recent-repos.py.
# After the first run, it tracks each repo's last sync timestamp.
SYNC_LOOKBACK_DAYS=7
