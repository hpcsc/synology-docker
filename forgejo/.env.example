# Base directory on the Synology host where app data is stored.
# Change this one value to move all app data to a different volume or path.
DOCKER_DATA_PATH=/volume1/docker

# Domain Forgejo will be served on.
FORGEJO_DOMAIN=git.example.com

# Set to false if you want to allow public registration.
DISABLE_REGISTRATION=true

# GitHub personal access token for mirroring private repositories.
# Classic token needs 'repo' scope. Fine-grained token needs read access to repos.
GITHUB_TOKEN=ghp_xxx

# Forgejo URL and API token for the mirror script.
# The token must have permission to create repositories.
FORGEJO_URL=https://git.example.com
FORGEJO_TOKEN=forgejo_api_token

# Forgejo username or organization that will own the mirrored repositories.
FORGEJO_OWNER=your_forgejo_username

# How often Forgejo should pull changes from GitHub.
MIRROR_INTERVAL=8h
