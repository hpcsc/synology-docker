# Base directory on the Synology host where app data is stored.
# Change this one value to move all app data to a different volume or path.
DOCKER_DATA_PATH=/volume1/docker

# Timezone for the container.
TZ=UTC

# UID and GID for the Forgejo container. On Synology, run `id` to find your user.
# Default values match a typical first Synology user.
USER_UID=1026
USER_GID=100

# Domain Forgejo will be served on. Used for SSH clone URLs.
FORGEJO_DOMAIN=penguin-nas

# Full base URL Forgejo is served on, including scheme and port.
# Used for HTTP(S) clone URLs and email notifications.
# If you use the mirror scripts, keep this in sync with FORGEJO_ROOT_URL in scripts/.env.
FORGEJO_ROOT_URL=https://penguin-nas:4000

# Set to false if you want to allow public registration.
DISABLE_REGISTRATION=true
